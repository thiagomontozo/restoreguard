RESTOREGUARD_ENV=development
RESTOREGUARD_HTTP_ADDR=:8080
RESTOREGUARD_DATABASE_URL=postgres://restoreguard:restoreguard@postgres:5432/restoreguard?sslmode=disable
RESTOREGUARD_SESSION_SECRET=replace-with-at-least-32-random-bytes
RESTOREGUARD_MASTER_KEY=replace-with-base64-encoded-32-byte-key
RESTOREGUARD_OBJECT_STORAGE_TYPE=s3
RESTOREGUARD_LOCAL_STORAGE_PATH=/var/lib/restoreguard/artifacts
RESTOREGUARD_S3_ENDPOINT=minio:9000
RESTOREGUARD_S3_BUCKET=restoreguard
RESTOREGUARD_S3_ACCESS_KEY=restoreguard
RESTOREGUARD_S3_SECRET_KEY=replace-me
RESTOREGUARD_S3_USE_TLS=false
RESTOREGUARD_MAX_CONCURRENT_DRILLS=2
RESTOREGUARD_MAX_ARTIFACT_BYTES=1073741824
RESTOREGUARD_DEFAULT_DRILL_TIMEOUT=30m
RESTOREGUARD_ALLOWED_POSTGRES_IMAGE=postgres:17.6-alpine
RESTOREGUARD_COOKIE_SECURE=false
RESTOREGUARD_CORS_ORIGIN=http://localhost:5173
RESTOREGUARD_BOOTSTRAP_ADMIN_EMAIL=admin@restoreguard.local
RESTOREGUARD_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-development-password
